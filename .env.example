# Copy to .env.local. Without a key the app runs in "Mock AI mode" (seed exercises, rule-based feedback).
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# GENERATE_EFFORT=low        # exercise generation
# ANALYZE_EFFORT=medium      # response analysis
# LLM_PROVIDER=mock          # force mock even with a key
# PGLITE_DIR=./data/pglite   # local database location
# FIRST_REVIEW_DELAY_HOURS=20
